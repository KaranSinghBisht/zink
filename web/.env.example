# Path to the patched zcash-devtool binary (see repo README, step 1)
ZINK_DEVTOOL_BIN=../../vendor/zcash-devtool/target/release/zcash-devtool

# View-only wallet directory created via `init-fvk` (README, step 2).
# Zink only needs the viewing key — never point this at a spending wallet.
ZINK_WALLET_DIR=../../wallets/zink-view

# lightwalletd server set: zecrocks | ywallet
ZINK_SERVER=zecrocks

# Public base URL used when sharing links
ZINK_BASE_URL=http://localhost:3000

# Wallet sync + payment detection interval
ZINK_SYNC_INTERVAL_MS=20000

# Confirmations required before an invoice is marked paid (min 1)
ZINK_MIN_CONFIRMATIONS=1

# Merchant admin token. REQUIRED for any non-local deployment: gates the
# dashboard, link creation/listing, and CSV export. Leave unset for
# local-only single-user use (routes stay open on localhost).
# ZINK_ADMIN_TOKEN=change-me-long-random-string

# Set to 1 for verbose server logs
ZINK_DEBUG=0
