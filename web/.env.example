# Path to the patched zcash-devtool binary (see repo README, step 1)
ZINK_DEVTOOL_BIN=../../vendor/zcash-devtool/target/release/zcash-devtool

# View-only wallet directory created via `init-fvk` (README, step 2).
# Zink only needs the viewing key — never point this at a spending wallet.
ZINK_WALLET_DIR=../../wallets/zink-view-test

# Zcash network: main | test. Keep separate wallet/database directories for
# each network. Testnet uses TAZ and utest1... unified addresses.
ZINK_NETWORK=test

# lightwalletd server set: zecrocks | ywallet
ZINK_SERVER=zecrocks

# Public base URL used when sharing links
ZINK_BASE_URL=http://localhost:3000

# Wallet sync + payment detection interval
ZINK_SYNC_INTERVAL_MS=20000

# Confirmations required before an invoice is marked paid (min 1)
ZINK_MIN_CONFIRMATIONS=1

# Merchant admin token (minimum 24 characters). REQUIRED whenever
# ZINK_WALLET_DIR is configured: it gates the dashboard, link creation/listing,
# and CSV export. Only the wallet-free hosted showcase is open without a token.
ZINK_ADMIN_TOKEN=replace-with-a-long-random-secret

# Only enable behind one trusted reverse proxy that overwrites X-Real-IP or
# appends the real client as the final X-Forwarded-For hop.
ZINK_TRUST_PROXY=0

# Set to 1 for verbose server logs
ZINK_DEBUG=0
